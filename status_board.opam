opam-version: "2.0"
synopsis: "Personal status board"
maintainer: "mbickers@fastmail.com"
authors: ["mbickers@fastmail.com"]
homepage: "maxbickers.com"
bug-reports: "mbickers@fastmail.com"

depends: [
  "ocaml" {= "5.1.1"}
  "dune" {>= "3.12"}
  "mustache" {>= "3.3.0" & < "3.4"}
  "core" {>= "v0.17" & < "v0.18"}
  "async" {>= "v0.17" & < "v0.18"}
  "async_ssl" {>= "v0.17" & < "v0.18"}
  "cohttp-async" {>= "6.2.2" & < "6.3"}
  "imagelib" {= "20221222"}
  "ocaml-lsp-server" {>= "1.18.0" & < "1.19"}
  # Version 6 eagerly initializes generated JSON decoders, which crashes on
  # the mutually recursive modules generated from the GTFS Realtime schema.
  "ocaml-protoc-plugin" {= "5.0.0"}
  "ocamlformat" {= "0.29.0"}
  "ppx_jane" {>= "v0.17" & < "v0.18"}
  "ppx_yojson_conv" {>= "v0.17" & < "v0.18"}
  "stb_truetype" {= "0.7"}
  "uri"
  "yojson"
]
